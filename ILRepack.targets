<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Merges ServerSync.dll into NonCombatStamina.dll and makes its types internal, so the package ships
       a single DLL and can't clash with other mods' copies of ServerSync. Picked up automatically by the
       ILRepack.Lib.MSBuild.Task package. -->
  <Target Name="ILRepacker" AfterTargets="Build">
    <ItemGroup>
      <InputAssemblies Include="$(TargetPath)" />
      <InputAssemblies Include="$(MSBuildThisFileDirectory)libs\ServerSync.dll" />
    </ItemGroup>
    <ILRepack Parallel="true" DebugInfo="true" Internalize="true" InputAssemblies="@(InputAssemblies)" OutputFile="$(TargetPath)" TargetKind="SameAsPrimaryAssembly" LibraryPath="$(OutDir);$(ValheimPublicized);$(ValheimManaged);$(BepInExCore);$(UnityCorlib)" />
  </Target>
</Project>
